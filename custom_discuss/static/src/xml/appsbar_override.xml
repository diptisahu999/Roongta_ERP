<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="muk_web_appsbar.AppsBar" t-inherit-mode="extension">
        <!-- Add the custom icon -->
        <xpath expr="//img[hasclass('mk_apps_sidebar_icon')][1]" position="before">
            <t t-if="app.xmlid === 'mail.menu_root_discuss' or app.label === 'Discussions'">
                <span class="mk_apps_sidebar_icon custom-discuss-icon-wrapper" style="display: inline-block; vertical-align: text-bottom; margin-right: 5px;">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 100%; height: 100%;">
                      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                    </svg>
                </span>
            </t>
        </xpath>
        
        <!-- Replace the default icons to inject custom logic -->
        <xpath expr="//img[@t-if='app.webIconData']" position="replace">
            <img t-if="app.webIconData and app.xmlid !== 'mail.menu_root_discuss' and app.label !== 'Discussions'" class="mk_apps_sidebar_icon" t-att-src="app.webIconData"/>
        </xpath>
        <xpath expr="//img[@t-else='']" position="replace">
            <img t-if="!app.webIconData and app.xmlid !== 'mail.menu_root_discuss' and app.label !== 'Discussions'" class="mk_apps_sidebar_icon" src="/base/static/description/icon.png"/>
        </xpath>

        <!-- Add the badge -->
        <xpath expr="//span[hasclass('mk_apps_sidebar_name')]" position="inside">
            <t t-if="app.xmlid === 'mail.menu_root_discuss' or app.label === 'Discussions'">
                <t t-set="mStore" t-value="this.env.services['mail.store']"/>
                <t t-set="mCount" t-value="this.discussCounter !== undefined ? this.discussCounter : (mStore and mStore.inbox and mStore.inbox.counter ? mStore.inbox.counter : 0)"/>
                <span class="badge custom-discuss-badge" t-if="mCount &gt; 0">
                    <t t-esc="mCount"/>
                </span>
            </t>
        </xpath>
    </t>
</templates>
