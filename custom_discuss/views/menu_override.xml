<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Override the Discuss menu item from the mail module -->
        <record id="mail.menu_root_discuss" model="ir.ui.menu">
            <field name="name">Discussions</field>
            <!-- Use base64 encoded SVG for guaranteed loading -->
            <field name="web_icon_data"></field>
            <!-- Still define web_icon as a fallback / identifier -->
            <field name="web_icon">custom_discuss,static/description/icon.png</field>
        </record>
    </data>
</odoo>
