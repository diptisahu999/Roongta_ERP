<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Client action for Custom WhatsApp-style Discussion -->
        <record id="action_custom_discuss" model="ir.actions.client">
            <field name="name">Discussions</field>
            <field name="tag">custom_discuss.discuss_action</field>
        </record>

        <!-- Override the root Discuss menu to trigger our custom client action -->
        <record id="mail.menu_root_discuss" model="ir.ui.menu">
            <field name="name">Discussions</field>
            <field name="action" ref="action_custom_discuss"/>
            <field name="web_icon_data"></field>
            <field name="web_icon">custom_discuss,static/description/icon.png</field>
        </record>
    </data>
</odoo>
