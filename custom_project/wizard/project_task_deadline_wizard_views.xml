<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_task_deadline_wizard_form" model="ir.ui.view">
        <field name="name">project.task.deadline.wizard.form</field>
        <field name="model">project.task.deadline.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Task Deadline">
                <group>
                    <field name="new_deadline"/>
                </group>
                <footer>
                    <button name="action_update_deadline" string="Update Deadline" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_project_task_deadline_wizard" model="ir.actions.act_window">
        <field name="name">Update Deadline</field>
        <field name="res_model">project.task.deadline.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
