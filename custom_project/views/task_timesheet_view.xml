<odoo>
    <!-- List (Tree) View: add Timesheets column after date_deadline -->
    <record id="view_task_tree_timesheet_inherit" model="ir.ui.view">
        <field name="name">project.task.list.timesheet.inherit</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.project_task_view_tree_main_base"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='priority']" position="attributes">
                <attribute name="widget">custom_priority_dropdown</attribute>
            </xpath>
            <xpath expr="//field[@name='date_deadline']" position="after">
                <field name="subtask_count" string="Sub-tasks" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='progress']" position="replace"/>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="column_invisible">1</attribute>
                <attribute name="optional"></attribute>
            </xpath>
        </field>
    </record>

    <!-- Hide Time Spent (effective_hours) & Time Remaining (remaining_hours) from Task List View -->
    <record id="view_task_tree2_inherited_hide_effective_hours" model="ir.ui.view">
        <field name="name">project.task.tree2.hide.effective.hours</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="hr_timesheet.view_task_tree2_inherited"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='effective_hours'][@widget='timesheet_uom']" position="replace"/>
            <xpath expr="//field[@name='remaining_hours']" position="attributes">
                <attribute name="column_invisible">1</attribute>
                <attribute name="optional"></attribute>
            </xpath>
        </field>
    </record>

    <!-- Kanban View: add Timesheets hours on the card -->
    <record id="view_task_kanban_timesheet_inherit" model="ir.ui.view">
        <field name="name">project.task.kanban.timesheet.inherit</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="timesheet_total" string="Timesheets" widget="time_hour_uom" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='priority'][@widget='priority']" position="attributes">
                <attribute name="widget">custom_priority_dropdown</attribute>
            </xpath>
            <xpath expr="//field[@name='remaining_hours'][@widget='timesheet_uom']" position="attributes">
                <attribute name="widget">time_hour_uom</attribute>
            </xpath>
            <xpath expr="//t[@name='allocated_hours']" position="inside">
                <div t-if="record.allocated_hours.raw_value &gt; 0 and record.allow_timesheets.raw_value" class="ms-1 align-self-center text-muted" title="Progress" groups="hr_timesheet.group_hr_timesheet_user">
                    <field name="progress" widget="percentage" options="{'digits': [1, 0]}"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Form View: add Timesheets total after task_properties field -->
    <record id="view_task_form_timesheet_inherit" model="ir.ui.view">
        <field name="name">project.task.form.timesheet.inherit</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='task_properties']" position="after">
                <group string="Timesheets">
                    <field name="timesheet_total" string="Total Hours" readonly="1" widget="time_hour_uom"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='priority']" position="attributes">
                <attribute name="widget">custom_priority_dropdown</attribute>
            </xpath>
            <xpath expr="//field[@name='child_ids']//field[@name='priority']" position="attributes">
                <attribute name="widget">custom_priority_dropdown</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']/.." position="inside">
                <field name="department_id" options="{'no_create': True}" required="1"/>
                <field name="assignable_user_ids" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='user_ids']" position="attributes">
                <attribute name="domain">[('id', 'in', assignable_user_ids)]</attribute>
                <attribute name="required">1</attribute>
                <attribute name="context">{'search_default_group_by_department': 1}</attribute>
            </xpath>
            <xpath expr="//div[@name='repeat_intervals']" position="inside">
                <span invisible="not recurring_task" class="me-2 fw-bold align-self-center">at</span>
                <field name="recurrence_time" widget="float_time" invisible="not recurring_task" class="me-2" style="max-width: 5rem !important;"/>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="single_tag_id" required="1" options="{'no_create': True}" placeholder="Tag"/>
                <field name="label_id" options="{'no_create': True, 'no_create_edit': True}" placeholder="Labels"/>
            </xpath>
            <xpath expr="//div[@id='date_deadline_and_recurring_task']/field[@name='date_deadline']" position="replace">
                <field name="is_deadline_readonly" invisible="1"/>
                <field name="date_deadline" required="1" readonly="is_deadline_readonly" nolabel="1" class="oe_inline"/>
            </xpath>
            <xpath expr="//page[@name='sub_tasks_page']" position="attributes">
                <attribute name="invisible">parent_id != False</attribute>
            </xpath>
            <xpath expr="//page[@name='page_timesheets']" position="attributes">
                <attribute name="invisible">parent_id != False</attribute>
            </xpath>
        </field>
    </record>

    <!-- Replace Employee column with User column in Timesheets tab -->
    <record id="view_task_form_user_timesheet" model="ir.ui.view">
        <field name="name">project.task.form.user.timesheet</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="hr_timesheet.view_task_form2_inherited"/>
        <field name="arch" type="xml">
            <!-- Form View inside Timesheet Lines -->
            <xpath expr="//field[@name='timesheet_ids']/form//field[@name='employee_id']" position="attributes">
                <attribute name="invisible">1</attribute>
                <attribute name="required">0</attribute>
            </xpath>
            <xpath expr="//field[@name='timesheet_ids']/form//field[@name='user_id']" position="attributes">
                <attribute name="invisible">0</attribute>
                <attribute name="required">1</attribute>
                <attribute name="widget">many2one_avatar_user</attribute>
            </xpath>
            
            <!-- List View inside Timesheet Lines -->
            <xpath expr="//field[@name='timesheet_ids']/list//field[@name='employee_id']" position="attributes">
                <attribute name="column_invisible">1</attribute>
                <attribute name="required">0</attribute>
            </xpath>
            <xpath expr="//field[@name='timesheet_ids']/list//field[@name='user_id']" position="attributes">
                <attribute name="column_invisible">0</attribute>
                <attribute name="required">1</attribute>
                <attribute name="widget">many2one_avatar_user</attribute>
            </xpath>
        </field>
    </record>

    <!-- Kanban Quick Create Form: add Department -->
    <record id="quick_create_task_form_department_inherit" model="ir.ui.view">
        <field name="name">project.task.form.quick_create.department</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.quick_create_task_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_ids']" position="after">
                <field name="assignable_user_ids" invisible="1"/>
                <field name="department_id" options="{'no_create': True}" required="1"/>
                <field name="single_tag_id" options="{'no_create_edit': True}" placeholder="Tag" required="1"/>
                <field name="label_id" options="{'no_create': True, 'no_create_edit': True}" placeholder="Labels"/>
                <field name="is_deadline_readonly" invisible="1"/>
                <field name="date_deadline" required="1" readonly="is_deadline_readonly"/>
            </xpath>
            <xpath expr="//field[@name='user_ids']" position="attributes">
                <attribute name="domain">[('id', 'in', assignable_user_ids)]</attribute>
                <attribute name="required">1</attribute>
                <attribute name="context">{'search_default_group_by_department': 1}</attribute>
            </xpath>
        </field>
    </record>

    <!-- Add Days Open and Task Progress to Task List View -->
    <record id="view_task_tree2_days_open" model="ir.ui.view">
        <field name="name">project.task.tree.days.open</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='progress']" position="replace"/>
            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='date_deadline']" position="before">
                <field name="department_id" string="Department" optional="hide"/>
                <field name="task_progress" string="Progress" widget="task_progress_select" optional="show"/>
                <field name="task_progress_rate" string="Progress Bar" widget="progressbar" optional="show"/>
                <field name="days_open" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Task Search View to add Days Open & Department filter -->
    <record id="view_task_search_form_days_open" model="ir.ui.view">
        <field name="name">project.task.search.days.open</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_ids']" position="after">
                <field name="days_open" string="Days Open"/>
                <field name="department_id" string="Department"/>
            </xpath>
            <xpath expr="//filter[@name='my_tasks']" position="before">
                <filter string="Today" name="deadline_today" domain="[('date_deadline', '=', context_today())]"/>
                <filter string="Next 7 Days" name="deadline_next_7_days" domain="[('date_deadline', '&gt;=', context_today()), ('date_deadline', '&lt;=', context_today() + datetime.timedelta(days=7))]"/>
                <filter string="Last 7 Days" name="deadline_last_7_days" domain="[('date_deadline', '&lt;=', context_today()), ('date_deadline', '&gt;=', context_today() - datetime.timedelta(days=7))]"/>
                <filter string="Last Month" name="deadline_last_month" domain="[('date_deadline', '&gt;=', context_today() - datetime.timedelta(days=30)), ('date_deadline', '&lt;=', context_today())]"/>
                <separator/>
            </xpath>
            <xpath expr="//search" position="inside">
                <group expand="0" string="Group By">
                    <filter string="Department" name="group_by_department" domain="[]" context="{'group_by': 'department_id'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Hide the Employees app menu -->
    <record id="hr.menu_hr_root" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- Hide the Timesheets app menu -->
    <record id="hr_timesheet.timesheet_menu_root" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
</odoo>
