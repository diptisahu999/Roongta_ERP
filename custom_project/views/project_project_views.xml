<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add "Assigned To" field on project form view, below Project Manager -->
    <record id="view_project_form_assigned_users" model="ir.ui.view">
        <field name="name">project.project.form.assigned.users</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="single_tag_id" required="1" options="{'no_create': True, 'no_open': True}" placeholder="Tag"/>
                <field name="department_id" options="{'no_create': True, 'no_open': True}" required="1"/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="before">
                <field name="create_uid" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="readonly">id and create_uid != uid and user_id != uid</attribute>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="assignable_user_ids" invisible="1"/>
                <field name="assigned_user_ids"
                       string="Assigned To"
                       widget="many2many_tags"
                       options="{'no_quick_create': True}"
                       domain="[('id', 'in', assignable_user_ids)]"
                       context="{'search_default_group_by_department': 1}"
                       required="1"/>
            </xpath>
        </field>
    </record>

    <!-- Add effective hours and progress to project kanban view -->
    <record id="view_project_kanban_effective_hours" model="ir.ui.view">
        <field name="name">project.project.kanban.effective.hours</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//templates" position="before">
                <field name="effective_hours"/>
                <field name="timesheet_progress_percentage"/>
            </xpath>
            <xpath expr="//div[hasclass('o_project_kanban_boxes')]" position="after">
                <div t-if="record.effective_hours.raw_value &gt; 0" class="d-inline-flex align-items-center ms-2 text-muted" title="Time Spent" groups="hr_timesheet.group_hr_timesheet_user">
                    <span class="fa fa-clock-o me-1" aria-label="Time Spent"/>
                    <field name="effective_hours" widget="time_hour_uom"/>
                </div>
                <div t-if="record.allocated_hours.raw_value &gt; 0" class="d-inline-flex align-items-center ms-2 text-muted" title="Progress" groups="hr_timesheet.group_hr_timesheet_user">
                    <field name="timesheet_progress_percentage" widget="percentage" options="{'digits': [1, 0]}"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Modify the simplified project create form: Add department_id and hide alias definition -->
    <record id="view_project_simplified_form_department" model="ir.ui.view">
        <field name="name">project.project.view.form.simplified.department</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.project_project_view_form_simplified"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <group>
                    <field name="department_id" options="{'no_create': True, 'no_open': True}" required="1"/>
                    <field name="single_tag_id" required="1" options="{'no_create': True, 'no_open': True}" placeholder="Tag"/>
                    <field name="assigned_user_ids" widget="many2many_avatar_user" required="1" string="Assigned To" context="{'search_default_group_by_department': 1}"/>
                </group>
            </xpath>
            <xpath expr="//div[@name='alias_def']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Modify the Kanban quick create project form -->
    <record id="quick_create_project_form_inherit" model="ir.ui.view">
        <field name="name">project.form.quick_create.inherit</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.quick_create_project_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <field name="department_id" options="{'no_create': True, 'no_open': True}" required="1"/>
                <field name="single_tag_id" options="{'no_create': True, 'no_open': True}" placeholder="Tag" required="1"/>
                <field name="assigned_user_ids" widget="many2many_avatar_user" required="1" string="Assigned To" context="{'search_default_group_by_department': 1}"/>
            </xpath>
        </field>
    </record>
</odoo>
