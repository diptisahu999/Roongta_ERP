<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Group to allow creating departments -->
    <record id="group_create_department" model="res.groups">
        <field name="name">Can Create Department</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>

    <record id="module_category_custom_project_deadline" model="ir.module.category">
        <field name="name">Task Deadline Access</field>
        <field name="description">Manage access to edit task deadlines after creation</field>
        <field name="sequence">51</field>
        <field name="visible" eval="True"/>
    </record>

    <!-- Group to allow editing task deadline after creation -->
    <record id="group_edit_task_deadline" model="res.groups">
        <field name="name">Can Edit Task Deadline</field>
        <field name="category_id" ref="custom_project.module_category_custom_project_deadline"/>
    </record>

    <!-- Custom Project: Manager group (sits between User and Administrator) -->
    <record id="group_project_manager_custom" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="base.module_category_services_project"/>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>

    <!-- Ensure Project: Administrator implies the new Manager group -->
    <record id="project.group_project_manager" model="res.groups">
        <field name="implied_ids" eval="[
            (4, ref('project.group_project_user')),
            (4, ref('custom_project.group_project_manager_custom')),
            (4, ref('mail.group_mail_canned_response_admin')),
        ]"/>
    </record>

    <!-- Allow custom Manager to see ALL tasks -->
    <record model="ir.rule" id="task_custom_manager_rule">
        <field name="name">Project/Task: custom manager: see all tasks</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('custom_project.group_project_manager_custom'))]"/>
    </record>

    <!-- Allow custom Manager to see ALL task stages (same as task_type_manager_rule for Admin) -->
    <record model="ir.rule" id="task_type_custom_manager_rule">
        <field name="name">Project/Task Type: custom manager sees all</field>
        <field name="model_id" ref="project.model_project_task_type"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('custom_project.group_project_manager_custom'))]"/>
    </record>

    <!-- Allow custom Manager to see ALL projects (same as project_project_manager_rule for Admin) -->
    <record model="ir.rule" id="project_project_custom_manager_rule">
        <field name="name">Project: custom manager: see all</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('custom_project.group_project_manager_custom'))]"/>
    </record>

    <!-- Allow custom Manager to see ALL project updates (same as update_visibility_project_admin for Admin) -->
    <record model="ir.rule" id="project_update_custom_manager_rule">
        <field name="name">Project/Update: custom manager: see all</field>
        <field name="model_id" ref="project.model_project_update"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('custom_project.group_project_manager_custom'))]"/>
    </record>

    <!-- Allow custom Manager to see ALL project milestones (same as milestone_visibility_project_admin for Admin) -->
    <record model="ir.rule" id="project_milestone_custom_manager_rule">
        <field name="name">Project/Milestone: custom manager: see all</field>
        <field name="model_id" ref="project.model_project_milestone"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('custom_project.group_project_manager_custom'))]"/>
    </record>

    <!-- Manager sees ALL users: Managers can see all users and managers across all departments -->
    <record model="ir.rule" id="res_users_department_manager_rule">
        <field name="name">Res Users: Manager sees all users</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('custom_project.group_project_manager_custom'))]"/>
    </record>

    <!-- Admin override for Leaderboard: Project Administrator sees all departments -->
    <record model="ir.rule" id="report_project_task_user_admin_rule">
        <field name="name">Report Project Task User: Project Admin sees all</field>
        <field name="model_id" ref="project.model_report_project_task_user"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('project.group_project_manager'))]"/>
    </record>

    <!-- Leaderboard department restriction for custom Manager and User -->
    <record model="ir.rule" id="report_project_task_user_department_rule">
        <field name="name">Report Project Task User: Department restriction</field>
        <field name="model_id" ref="project.model_report_project_task_user"/>
        <field name="domain_force">['|', ('department_id', '=', False), ('department_id', '=', user.department_id.id)]</field>
        <field name="groups" eval="[(4, ref('custom_project.group_project_manager_custom')), (4, ref('project.group_project_user'))]"/>
    </record>

    <!-- Admin override: Only true Settings Admins see ALL users -->
    <record model="ir.rule" id="res_users_admin_sees_all_rule">
        <field name="name">Res Users: Administrator sees all users</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <!-- Custom Category for Project Tags -->
    <record id="module_category_custom_project_tags" model="ir.module.category">
        <field name="name">Tags Access</field>
        <field name="description">Manage access rights for project tags</field>
        <field name="sequence">50</field>
        <field name="visible" eval="True"/>
    </record>

    <!-- Group to explicitly grant project tag creation rights -->
    <record id="group_project_tags_create" model="res.groups">
        <field name="name">Allows Creating Tags</field>
        <field name="category_id" ref="custom_project.module_category_custom_project_tags"/>
        <field name="comment">Users in this group can create new project tags.</field>
    </record>

</odoo>