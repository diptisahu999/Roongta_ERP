<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Scheduled Action: Send overdue task web notifications daily at 10:30 AM IST -->
        <record id="ir_cron_overdue_task_notify" model="ir.cron">
            <field name="name">Overdue Task Web Notifier</field>
            <field name="model_id" ref="custom_overdue_notify.model_custom_overdue_notify"/>
            <field name="state">code</field>
            <field name="code">model.send_overdue_notifications()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall">2024-01-01 05:00:00</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
