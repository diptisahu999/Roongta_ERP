<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="action_department_dashboard" model="ir.actions.client">
        <field name="name">Home</field>
        <field name="tag">department_dashboard_action</field>
    </record>

    <record id="action_project_meeting_calendar" model="ir.actions.client">
        <field name="name">Calendar</field>
        <field name="tag">project_meeting_calendar_action</field>
    </record>

    <menuitem
        id="menu_department_dashboard"
        name="Home"
        parent="project.menu_main_pm"
        action="action_department_dashboard"
        sequence="-5"
        groups="project.group_project_user"
    />

    <!-- Override standard calendar menu items to point to our client action -->
    <record id="calendar.mail_menu_calendar" model="ir.ui.menu">
        <field name="action" ref="project_dashboard.action_project_meeting_calendar"/>
    </record>

    <record id="calendar.calendar_event_menu" model="ir.ui.menu">
        <field name="action" ref="project_dashboard.action_project_meeting_calendar"/>
    </record>

    <!-- ── Security Groups for Department App ─────────────────────────────── -->
    <record id="module_category_department" model="ir.module.category">
        <field name="name">Department</field>
        <field name="parent_id" ref="base.module_category_human_resources"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_department_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_department"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_department_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_department"/>
        <field name="implied_ids" eval="[(4, ref('project_dashboard.group_department_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- ── Menu Item — Department (sequence=-1, FIRST in Project app) ─────── -->
    <record id="action_project_department" model="ir.actions.act_window">
        <field name="name">Sub Departments</field>
        <field name="res_model">hr.department</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem
        id="menu_project_department"
        name="Sub Department"
        action="action_project_department"
        parent="project.menu_project_config"
        sequence="40"
    />
    <!-- Explicitly replace groups to ensure old groups (project_user) are removed -->
    <record id="menu_project_department" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('project_dashboard.group_department_user')])]"/>
    </record>

    <!-- We keep the "Grouped by Stage" menu fully active but we force it to load the standard UNGROUPED views! -->
    <record id="project.menu_projects_group_stage" model="ir.ui.menu">
        <field name="active" eval="True"/>
        <field name="parent_id" ref="project.menu_main_pm"/>
        <field name="sequence">10</field>
    </record>

    <record id="project.open_view_project_all_group_stage_kanban_view" model="ir.actions.act_window.view">
        <field name="view_id" ref="project.view_project_kanban"/>
    </record>
    
    <record id="project.open_view_project_all_group_stage_tree_view" model="ir.actions.act_window.view">
        <field name="view_id" ref="project.view_project"/>
    </record>
    <!-- ── Override Odoo's Projects menu to appear after Department ─────────── -->
    <record id="project.menu_projects" model="ir.ui.menu">
        <field name="sequence">10</field>
    </record>

    <!-- Override Odoo's Tasks menu to appear after Projects -->
    <record id="project.menu_project_management" model="ir.ui.menu">
        <field name="sequence">20</field>
    </record>

    <!-- ── Make Kanban View the default for Project Tasks ──────────────────────── -->
    <record id="project.act_project_project_2_project_task_all" model="ir.actions.act_window">
        <field name="view_mode">kanban,list,form,calendar,pivot,graph,activity</field>
    </record>
    
    <!-- Reverting sequence to make Kanban the default over list view -->
    <record id="project.project_task_tree_action_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="15"/>
    </record>
    <!-- Make Project Field Required when created from Dashboard -->
    <record id="view_task_form_dashboard_required" model="ir.ui.view">
        <field name="name">project.task.form.dashboard.required</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='project_id']" position="attributes">
                <attribute name="required">context.get('dashboard_force_project_required', False)</attribute>
            </xpath>
        </field>
    </record>

    <!-- Add Last Updated On (write_date) and Created By to Task List View -->
    <record id="view_task_tree2_dashboard_write_date" model="ir.ui.view">
        <field name="name">project.task.tree.dashboard.write_date</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='project_id']" position="after">
                <field name="write_date" string="Last Updated On" optional="show"/>
                <field name="create_uid" string="Created By" optional="show" widget="many2one_avatar_user"/>
            </xpath>
        </field>
    </record>

    <!-- Hide Login Footer elements (Manage Databases, Powered by Odoo, Use another user, Don't have an account) -->
    <template id="hide_login_footer_custom" inherit_id="web.login_layout">
        <xpath expr="//div[hasclass('card-body')]" position="inside">
            <style>
                <![CDATA[
                /* Hide Manage Databases & Powered by Odoo */
                .text-center.small.mt-4.pt-3.border-top { display: none !important; }
                a[href^="/web/database/manager"] { display: none !important; }
                a[href^="https://www.odoo.com"] { display: none !important; }
                
                /* Hide 'Use another user' link */
                .card-body a:has(.fa-user-circle-o) { display: none !important; }
                .card-body div:has(> a:has(.fa-user-circle-o)) { display: none !important; }

                /* Hide 'Don't have an account?' signup link */
                a[href^="/web/signup"] { display: none !important; }
                ]]>
            </style>
        </xpath>
    </template>

</odoo>