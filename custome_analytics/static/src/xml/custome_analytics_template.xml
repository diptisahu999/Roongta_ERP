<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="custome_analytics.Dashboard" owl="1">
        <div class="ca-dashboard-container">
            <t t-if="state.isLoading">
                <div class="ca-loading-overlay">
                    <div class="ca-spinner"></div>
                    <div>Loading Analytics Dashboard...</div>
                </div>
            </t>
            
            <t t-if="!state.isLoading and state.data">
                <!-- Top Header Bar -->
                <div class="ca-header">
                    <div class="ca-header-title">
                        <h1>Analytics</h1>
                        <p>Get insights and track performance across projects, teams and departments.</p>
                    </div>
                    <div class="ca-header-actions">
                        <!-- Date Range Picker Pill -->
                        <div class="ca-action-pill ca-date-pill" t-on-click="toggleDateDropdown">
                            <i class="fa fa-calendar ca-pill-icon"></i>
                            <span class="ca-pill-text" t-esc="state.data.filters.current_date_str"></span>
                            <i class="fa fa-chevron-down ca-pill-caret"></i>

                            <!-- Date Range Dropdown Menu -->
                            <t t-if="state.openDropdown === 'date'">
                                <div class="ca-dropdown-menu ca-date-menu">
                                    <div class="ca-dropdown-item" t-att-class="{'active': state.dateRange === 'last_month'}" t-on-click="() => this.setDatePreset('last_month')">Last Month (Aug 2026)</div>
                                    <div class="ca-dropdown-item" t-att-class="{'active': state.dateRange === 'this_month'}" t-on-click="() => this.setDatePreset('this_month')">This Month</div>
                                    <div class="ca-dropdown-item" t-att-class="{'active': state.dateRange === '30d'}" t-on-click="() => this.setDatePreset('30d')">Last 30 Days</div>
                                    <div class="ca-dropdown-item" t-att-class="{'active': state.dateRange === '90d'}" t-on-click="() => this.setDatePreset('90d')">Last 90 Days</div>
                                    <div class="ca-dropdown-item" t-att-class="{'active': state.dateRange === 'this_year'}" t-on-click="() => this.setDatePreset('this_year')">This Year</div>
                                    <div class="ca-dropdown-item" t-att-class="{'active': state.dateRange === 'all'}" t-on-click="() => this.setDatePreset('all')">All Time</div>
                                    <div class="ca-dropdown-divider"></div>
                                    <div class="ca-custom-date-box">
                                        <div class="ca-custom-date-title">Custom Range</div>
                                        <div class="ca-custom-date-inputs">
                                            <input type="date" t-model="state.dateFrom" class="ca-custom-input"/>
                                            <span>to</span>
                                            <input type="date" t-model="state.dateTo" class="ca-custom-input"/>
                                        </div>
                                        <button class="ca-btn-apply" t-on-click="applyCustomDate">Apply</button>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <!-- Quick Filters Pill -->
                        <div class="ca-action-pill ca-filter-pill" t-on-click="toggleQuickFilters">
                            <i class="fa fa-sliders ca-pill-icon"></i>
                            <span class="ca-pill-text">Filters</span>
                            <i class="fa fa-chevron-down ca-pill-caret"></i>

                            <t t-if="state.openDropdown === 'quick_filter'">
                                <div class="ca-dropdown-menu ca-filter-menu">
                                    <div class="ca-dropdown-item" t-att-class="{'active': state.filterCustomView === 'all'}" t-on-click="() => this.setQuickFilter('all')">All Tasks</div>
                                    <div class="ca-dropdown-item" t-att-class="{'active': state.filterCustomView === 'overdue'}" t-on-click="() => this.setQuickFilter('overdue')">Overdue Only</div>
                                    <div class="ca-dropdown-item" t-att-class="{'active': state.filterCustomView === 'high_priority'}" t-on-click="() => this.setQuickFilter('high_priority')">High Priority</div>
                                    <div class="ca-dropdown-item" t-att-class="{'active': state.filterCustomView === 'blocked'}" t-on-click="() => this.setQuickFilter('blocked')">Blocked Only</div>
                                    <div class="ca-dropdown-item" t-att-class="{'active': state.filterCustomView === 'my_tasks'}" t-on-click="() => this.setQuickFilter('my_tasks')">My Tasks</div>
                                </div>
                            </t>
                        </div>

                        <!-- Export Button -->
                        <button class="ca-action-pill ca-export-pill" t-on-click="exportData">
                            <i class="fa fa-download ca-pill-icon"></i>
                            <span class="ca-pill-text">Export</span>
                        </button>


                        <!-- User Profile Pill -->
                        <div class="ca-user-pill">
                            <img class="ca-user-avatar" t-att-src="state.data.user.avatar_url" alt="User Avatar" t-on-error="onAvatarError"/>
                            <div class="ca-user-info">
                                <span class="ca-user-name" t-esc="state.data.user.name"></span>
                            </div>
                            <i class="fa fa-chevron-down ca-user-caret"></i>
                        </div>
                    </div>
                </div>

                <!-- Secondary Filter Bar (5 Custom Filter Selectors) -->
                <div class="ca-secondary-filters">
                    <!-- 1. All Companies -->
                    <div class="ca-custom-dropdown" t-att-class="{'is-open': state.openDropdown === 'company'}">
                        <div class="ca-dropdown-trigger" t-on-click="(ev) => this.toggleFilterDropdown('company', ev)">
                            <i class="fa fa-building-o ca-f-icon"></i>
                            <span class="ca-dropdown-selected-label" t-esc="selectedCompanyName"></span>
                            <i class="fa fa-chevron-down ca-f-arrow"></i>
                        </div>
                        <t t-if="state.openDropdown === 'company'">
                            <div class="ca-custom-dropdown-popover">
                                <div class="ca-dropdown-options-list">
                                    <div class="ca-dropdown-option-item" 
                                         t-att-class="{'selected': state.filterCompany === 'all'}" 
                                         t-on-click="() => this.selectCompany('all')">
                                        <span class="ca-opt-name">All Companies</span>
                                        <i t-if="state.filterCompany === 'all'" class="fa fa-check ca-opt-check"></i>
                                    </div>
                                    <t t-foreach="state.data.filters.companies" t-as="c" t-key="c.id">
                                        <div class="ca-dropdown-option-item" 
                                             t-att-class="{'selected': state.filterCompany === c.id.toString()}" 
                                             t-on-click="() => this.selectCompany(c.id)">
                                            <span class="ca-opt-name" t-esc="c.name"></span>
                                            <i t-if="state.filterCompany === c.id.toString()" class="fa fa-check ca-opt-check"></i>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>

                    <!-- 2. All Departments -->
                    <div class="ca-custom-dropdown" t-att-class="{'is-open': state.openDropdown === 'department'}">
                        <div class="ca-dropdown-trigger" t-on-click="(ev) => this.toggleFilterDropdown('department', ev)">
                            <i class="fa fa-users ca-f-icon"></i>
                            <span class="ca-dropdown-selected-label" t-esc="selectedDepartmentName"></span>
                            <i class="fa fa-chevron-down ca-f-arrow"></i>
                        </div>
                        <t t-if="state.openDropdown === 'department'">
                            <div class="ca-custom-dropdown-popover">
                                <div class="ca-dropdown-search-box">
                                    <i class="fa fa-search ca-dropdown-search-icon"></i>
                                    <input type="text" 
                                           placeholder="Search department..." 
                                           t-model="state.searchDept" 
                                           class="ca-dropdown-search-input"
                                           autofocus="autofocus"/>
                                </div>
                                <div class="ca-dropdown-options-list">
                                    <div class="ca-dropdown-option-item" 
                                         t-att-class="{'selected': state.filterDept === 'all'}" 
                                         t-on-click="() => this.selectDepartment('all')">
                                        <span class="ca-opt-name">All Departments</span>
                                        <i t-if="state.filterDept === 'all'" class="fa fa-check ca-opt-check"></i>
                                    </div>
                                    <t t-foreach="filteredDepartments" t-as="d" t-key="d.id">
                                        <div class="ca-dropdown-option-item" 
                                             t-att-class="{'selected': state.filterDept === d.id.toString()}" 
                                             t-on-click="() => this.selectDepartment(d.id)">
                                            <span class="ca-opt-name" t-esc="d.name"></span>
                                            <i t-if="state.filterDept === d.id.toString()" class="fa fa-check ca-opt-check"></i>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>

                    <!-- 3. All Assignees -->
                    <div class="ca-custom-dropdown" t-att-class="{'is-open': state.openDropdown === 'employee'}">
                        <div class="ca-dropdown-trigger" t-on-click="(ev) => this.toggleFilterDropdown('employee', ev)">
                            <i class="fa fa-user-circle-o ca-f-icon"></i>
                            <span class="ca-dropdown-selected-label" t-esc="selectedEmployeeName"></span>
                            <i class="fa fa-chevron-down ca-f-arrow"></i>
                        </div>
                        <t t-if="state.openDropdown === 'employee'">
                            <div class="ca-custom-dropdown-popover">
                                <div class="ca-dropdown-search-box">
                                    <i class="fa fa-search ca-dropdown-search-icon"></i>
                                    <input type="text" 
                                           placeholder="Search assignee..." 
                                           t-model="state.searchEmployee" 
                                           class="ca-dropdown-search-input"
                                           autofocus="autofocus"/>
                                </div>
                                <div class="ca-dropdown-options-list">
                                    <div class="ca-dropdown-option-item" 
                                         t-att-class="{'selected': state.filterEmployee === 'all'}" 
                                         t-on-click="() => this.selectEmployee('all')">
                                        <span class="ca-opt-name">All Assignees</span>
                                        <i t-if="state.filterEmployee === 'all'" class="fa fa-check ca-opt-check"></i>
                                    </div>
                                    <t t-foreach="filteredEmployees" t-as="e" t-key="e.id">
                                        <div class="ca-dropdown-option-item" 
                                             t-att-class="{'selected': state.filterEmployee === e.id.toString()}" 
                                             t-on-click="() => this.selectEmployee(e.id)">
                                            <span class="ca-opt-name" t-esc="e.name"></span>
                                            <i t-if="state.filterEmployee === e.id.toString()" class="fa fa-check ca-opt-check"></i>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>

                    <!-- 4. All Projects -->
                    <div class="ca-custom-dropdown" t-att-class="{'is-open': state.openDropdown === 'project'}">
                        <div class="ca-dropdown-trigger" t-on-click="(ev) => this.toggleFilterDropdown('project', ev)">
                            <i class="fa fa-folder-o ca-f-icon"></i>
                            <span class="ca-dropdown-selected-label" t-esc="selectedProjectName"></span>
                            <i class="fa fa-chevron-down ca-f-arrow"></i>
                        </div>
                        <t t-if="state.openDropdown === 'project'">
                            <div class="ca-custom-dropdown-popover">
                                <div class="ca-dropdown-search-box">
                                    <i class="fa fa-search ca-dropdown-search-icon"></i>
                                    <input type="text" 
                                           placeholder="Search project..." 
                                           t-model="state.searchProject" 
                                           class="ca-dropdown-search-input"
                                           autofocus="autofocus"/>
                                </div>
                                <div class="ca-dropdown-options-list">
                                    <div class="ca-dropdown-option-item" 
                                         t-att-class="{'selected': state.filterProject === 'all'}" 
                                         t-on-click="() => this.selectProject('all')">
                                        <span class="ca-opt-name">All Projects</span>
                                        <i t-if="state.filterProject === 'all'" class="fa fa-check ca-opt-check"></i>
                                    </div>
                                    <t t-foreach="filteredProjects" t-as="p" t-key="p.id">
                                        <div class="ca-dropdown-option-item" 
                                             t-att-class="{'selected': state.filterProject === p.id.toString()}" 
                                             t-on-click="() => this.selectProject(p.id)">
                                            <span class="ca-opt-name" t-esc="p.name"></span>
                                            <i t-if="state.filterProject === p.id.toString()" class="fa fa-check ca-opt-check"></i>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>

                    <!-- 5. Custom View -->
                    <div class="ca-custom-dropdown" t-att-class="{'is-open': state.openDropdown === 'custom_view'}">
                        <div class="ca-dropdown-trigger" t-on-click="(ev) => this.toggleFilterDropdown('custom_view', ev)">
                            <i class="fa fa-sliders ca-f-icon"></i>
                            <span class="ca-dropdown-selected-label" t-esc="selectedCustomViewName"></span>
                            <i class="fa fa-chevron-down ca-f-arrow"></i>
                        </div>
                        <t t-if="state.openDropdown === 'custom_view'">
                            <div class="ca-custom-dropdown-popover">
                                <div class="ca-dropdown-options-list">
                                    <div class="ca-dropdown-option-item" 
                                         t-att-class="{'selected': state.filterCustomView === 'all'}" 
                                         t-on-click="() => this.selectCustomView('all')">
                                        <span class="ca-opt-name">Custom View (All)</span>
                                        <i t-if="state.filterCustomView === 'all'" class="fa fa-check ca-opt-check"></i>
                                    </div>
                                    <div class="ca-dropdown-option-item" 
                                         t-att-class="{'selected': state.filterCustomView === 'my_tasks'}" 
                                         t-on-click="() => this.selectCustomView('my_tasks')">
                                        <span class="ca-opt-name">My Tasks</span>
                                        <i t-if="state.filterCustomView === 'my_tasks'" class="fa fa-check ca-opt-check"></i>
                                    </div>
                                    <div class="ca-dropdown-option-item" 
                                         t-att-class="{'selected': state.filterCustomView === 'high_priority'}" 
                                         t-on-click="() => this.selectCustomView('high_priority')">
                                        <span class="ca-opt-name">High Priority</span>
                                        <i t-if="state.filterCustomView === 'high_priority'" class="fa fa-check ca-opt-check"></i>
                                    </div>
                                    <div class="ca-dropdown-option-item" 
                                         t-att-class="{'selected': state.filterCustomView === 'blocked'}" 
                                         t-on-click="() => this.selectCustomView('blocked')">
                                        <span class="ca-opt-name">Blocked Tasks</span>
                                        <i t-if="state.filterCustomView === 'blocked'" class="fa fa-check ca-opt-check"></i>
                                    </div>
                                    <div class="ca-dropdown-option-item" 
                                         t-att-class="{'selected': state.filterCustomView === 'overdue'}" 
                                         t-on-click="() => this.selectCustomView('overdue')">
                                        <span class="ca-opt-name">Overdue Tasks</span>
                                        <i t-if="state.filterCustomView === 'overdue'" class="fa fa-check ca-opt-check"></i>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- 5 Metric KPI Cards Row -->
                <div class="ca-metric-cards-row">
                    <!-- Total Tasks -->
                    <div class="ca-kpi-card" t-on-click="() => this.openTasks('total')">
                        <div class="ca-kpi-top">
                            <div class="ca-kpi-icon-box ca-icon-purple">
                                <i class="fa fa-clipboard"></i>
                            </div>
                            <div class="ca-kpi-meta">
                                <span class="ca-kpi-title">Total Tasks</span>
                                <span class="ca-kpi-val" t-esc="state.data.overview.total_tasks.toLocaleString()"></span>
                                <div class="ca-kpi-trend ca-trend-green">
                                    <i class="fa fa-arrow-up"></i>
                                    <span t-esc="state.data.overview.total_tasks_trend + '%'"></span>
                                    <span class="ca-trend-vs" t-esc="state.data.filters.vs_date_str"></span>
                                </div>
                            </div>
                        </div>
                        <!-- Sparkline Wave SVG -->
                        <div class="ca-kpi-sparkline">
                            <svg viewBox="0 0 180 36" preserveAspectRatio="none">
                                <defs>
                                    <linearGradient id="ca-grad-purple" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="#8B5CF6" stop-opacity="0.25"/>
                                        <stop offset="100%" stop-color="#8B5CF6" stop-opacity="0"/>
                                    </linearGradient>
                                </defs>
                                <path t-att-d="getSparklineFill(state.data.overview.sparklines.total_tasks)" fill="url(#ca-grad-purple)"/>
                                <path t-att-d="getSparklinePath(state.data.overview.sparklines.total_tasks)" fill="none" stroke="#8B5CF6" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                        </div>
                    </div>

                    <!-- Completed Tasks -->
                    <div class="ca-kpi-card" t-on-click="() => this.openTasks('completed')">
                        <div class="ca-kpi-top">
                            <div class="ca-kpi-icon-box ca-icon-green">
                                <i class="fa fa-check-circle"></i>
                            </div>
                            <div class="ca-kpi-meta">
                                <span class="ca-kpi-title">Completed Tasks</span>
                                <span class="ca-kpi-val" t-esc="state.data.overview.completed_tasks.toLocaleString()"></span>
                                <div class="ca-kpi-trend ca-trend-green">
                                    <i class="fa fa-arrow-up"></i>
                                    <span t-esc="state.data.overview.completed_tasks_trend + '%'"></span>
                                    <span class="ca-trend-vs" t-esc="state.data.filters.vs_date_str"></span>
                                </div>
                            </div>
                        </div>
                        <div class="ca-kpi-sparkline">
                            <svg viewBox="0 0 180 36" preserveAspectRatio="none">
                                <defs>
                                    <linearGradient id="ca-grad-green" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="#10B981" stop-opacity="0.25"/>
                                        <stop offset="100%" stop-color="#10B981" stop-opacity="0"/>
                                    </linearGradient>
                                </defs>
                                <path t-att-d="getSparklineFill(state.data.overview.sparklines.completed_tasks)" fill="url(#ca-grad-green)"/>
                                <path t-att-d="getSparklinePath(state.data.overview.sparklines.completed_tasks)" fill="none" stroke="#10B981" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                        </div>
                    </div>

                    <!-- Completion Rate -->
                    <div class="ca-kpi-card">
                        <div class="ca-kpi-top">
                            <div class="ca-kpi-icon-box ca-icon-orange">
                                <i class="fa fa-pie-chart"></i>
                            </div>
                            <div class="ca-kpi-meta">
                                <span class="ca-kpi-title">Completion Rate</span>
                                <span class="ca-kpi-val" t-esc="state.data.overview.completion_rate + '%'"></span>
                                <div class="ca-kpi-trend ca-trend-green">
                                    <i class="fa fa-arrow-up"></i>
                                    <span t-esc="state.data.overview.completion_rate_trend + '%'"></span>
                                    <span class="ca-trend-vs" t-esc="state.data.filters.vs_date_str"></span>
                                </div>
                            </div>
                        </div>
                        <div class="ca-kpi-sparkline">
                            <svg viewBox="0 0 180 36" preserveAspectRatio="none">
                                <defs>
                                    <linearGradient id="ca-grad-orange" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="#F97316" stop-opacity="0.25"/>
                                        <stop offset="100%" stop-color="#F97316" stop-opacity="0"/>
                                    </linearGradient>
                                </defs>
                                <path t-att-d="getSparklineFill(state.data.overview.sparklines.completion_rate)" fill="url(#ca-grad-orange)"/>
                                <path t-att-d="getSparklinePath(state.data.overview.sparklines.completion_rate)" fill="none" stroke="#F97316" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                        </div>
                    </div>

                    <!-- Overdue Tasks -->
                    <div class="ca-kpi-card" t-on-click="() => this.openTasks('overdue')">
                        <div class="ca-kpi-top">
                            <div class="ca-kpi-icon-box ca-icon-red">
                                <i class="fa fa-clock-o"></i>
                            </div>
                            <div class="ca-kpi-meta">
                                <span class="ca-kpi-title">Overdue Tasks</span>
                                <span class="ca-kpi-val" t-esc="state.data.overview.overdue_tasks.toLocaleString()"></span>
                                <div class="ca-kpi-trend ca-trend-red">
                                    <i class="fa fa-arrow-down"></i>
                                    <span t-esc="Math.abs(state.data.overview.overdue_tasks_trend) + '%'"></span>
                                    <span class="ca-trend-vs" t-esc="state.data.filters.vs_date_str"></span>
                                </div>
                            </div>
                        </div>
                        <div class="ca-kpi-sparkline">
                            <svg viewBox="0 0 180 36" preserveAspectRatio="none">
                                <defs>
                                    <linearGradient id="ca-grad-red" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="#EF4444" stop-opacity="0.25"/>
                                        <stop offset="100%" stop-color="#EF4444" stop-opacity="0"/>
                                    </linearGradient>
                                </defs>
                                <path t-att-d="getSparklineFill(state.data.overview.sparklines.overdue_tasks)" fill="url(#ca-grad-red)"/>
                                <path t-att-d="getSparklinePath(state.data.overview.sparklines.overdue_tasks)" fill="none" stroke="#EF4444" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                        </div>
                    </div>

                    <!-- Blocked Tasks -->
                    <div class="ca-kpi-card" t-on-click="() => this.openTasks('blocked')">
                        <div class="ca-kpi-top">
                            <div class="ca-kpi-icon-box ca-icon-slate">
                                <i class="fa fa-lock"></i>
                            </div>
                            <div class="ca-kpi-meta">
                                <span class="ca-kpi-title">Blocked Tasks</span>
                                <span class="ca-kpi-val" t-esc="state.data.overview.blocked_tasks.toLocaleString()"></span>
                                <div class="ca-kpi-trend ca-trend-slate">
                                    <i class="fa fa-arrow-down"></i>
                                    <span t-esc="Math.abs(state.data.overview.blocked_tasks_trend) + '%'"></span>
                                    <span class="ca-trend-vs" t-esc="state.data.filters.vs_date_str"></span>
                                </div>
                            </div>
                        </div>
                        <div class="ca-kpi-sparkline">
                            <svg viewBox="0 0 180 36" preserveAspectRatio="none">
                                <defs>
                                    <linearGradient id="ca-grad-slate" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="#64748B" stop-opacity="0.25"/>
                                        <stop offset="100%" stop-color="#64748B" stop-opacity="0"/>
                                    </linearGradient>
                                </defs>
                                <path t-att-d="getSparklineFill(state.data.overview.sparklines.blocked_tasks)" fill="url(#ca-grad-slate)"/>
                                <path t-att-d="getSparklinePath(state.data.overview.sparklines.blocked_tasks)" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                        </div>
                    </div>
                </div>

                <!-- Middle Charts Row (3 Charts) -->
                <div class="ca-middle-charts-row">
                    <!-- Tasks Over Time (Line Chart) -->
                    <div class="ca-card ca-chart-card ca-chart-card-time">
                        <div class="ca-card-header">
                            <div class="ca-card-title-group">
                                <span class="ca-card-title">Tasks Over Time</span>
                                <div class="ca-chart-legend-top">
                                    <div class="ca-legend-bullet-item">
                                        <span class="ca-bullet-dot" style="background-color: #8B5CF6;"></span>
                                        <span>Created</span>
                                    </div>
                                    <div class="ca-legend-bullet-item">
                                        <span class="ca-bullet-dot" style="background-color: #10B981;"></span>
                                        <span>Completed</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="ca-chart-canvas-wrapper">
                            <canvas t-ref="tasksOverTimeCanvas"></canvas>
                        </div>
                    </div>

                    <!-- Tasks by Status (Donut Chart) -->
                    <div class="ca-card ca-chart-card ca-chart-card-status">
                        <div class="ca-card-header">
                            <span class="ca-card-title">Tasks by Status</span>
                        </div>
                        <div class="ca-donut-flex-container">
                            <div class="ca-donut-canvas-wrapper">
                                <canvas t-ref="tasksStatusCanvas"></canvas>
                            </div>
                            <div class="ca-donut-legend-list">
                                <t t-foreach="state.data.tasks_by_status.items" t-as="item" t-key="item.label">
                                    <div class="ca-donut-legend-row" t-on-click="() => this.openTasks(item.label.toLowerCase().replace(' ', '_'))">
                                        <div class="ca-donut-legend-left">
                                            <span class="ca-legend-color-dot" t-attf-style="background-color: {{ item.color }};"></span>
                                            <span class="ca-donut-label" t-esc="item.label"></span>
                                        </div>
                                        <div class="ca-donut-value">
                                            <span t-esc="item.count"></span>
                                            <span class="ca-donut-pct" t-esc="'(' + item.pct + '%)'"></span>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- Tasks by Priority (Donut Chart) -->
                    <div class="ca-card ca-chart-card ca-chart-card-priority">
                        <div class="ca-card-header">
                            <span class="ca-card-title">Tasks by Priority</span>
                        </div>
                        <div class="ca-donut-flex-container">
                            <div class="ca-donut-canvas-wrapper">
                                <canvas t-ref="tasksPriorityCanvas"></canvas>
                            </div>
                            <div class="ca-donut-legend-list">
                                <t t-foreach="state.data.tasks_by_priority.items" t-as="item" t-key="item.label">
                                    <div class="ca-donut-legend-row">
                                        <div class="ca-donut-legend-left">
                                            <span class="ca-legend-color-dot" t-attf-style="background-color: {{ item.color }};"></span>
                                            <span class="ca-donut-label" t-esc="item.label"></span>
                                        </div>
                                        <div class="ca-donut-value">
                                            <span t-esc="item.count"></span>
                                            <span class="ca-donut-pct" t-esc="'(' + item.pct + '%)'"></span>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Third Row (3 Tables / Cards) -->
                <div class="ca-tables-row">
                    <!-- Performance by Department -->
                    <div class="ca-card ca-table-card">
                        <div class="ca-card-header">
                            <span class="ca-card-title">Performance by Department</span>
                        </div>
                        <div class="ca-table-scroll-container">
                            <table class="ca-clean-table">
                                <thead>
                                    <tr>
                                        <th>Department</th>
                                        <th>Total Tasks</th>
                                        <th>Completed</th>
                                        <th>Overdue</th>
                                        <th>Completion Rate</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.data.department_performance" t-as="dept" t-key="dept.id || dept.department">
                                        <tr t-on-click="() => this.filterByDepartment(dept.id)">
                                            <td>
                                                <div class="ca-row-name-cell">
                                                    <div class="ca-dept-avatar-icon" t-attf-style="background-color: {{ dept.bg_color }}; color: {{ dept.color }};">
                                                        <i t-attf-class="fa {{ dept.icon }}"></i>
                                                    </div>
                                                    <span class="ca-row-name-text" t-esc="dept.department"></span>
                                                </div>
                                            </td>
                                            <td class="ca-num-cell" t-esc="dept.total_tasks"></td>
                                            <td class="ca-num-cell" t-esc="dept.completed"></td>
                                            <td class="ca-num-cell" t-esc="dept.overdue"></td>
                                            <td>
                                                <div class="ca-rate-progress-cell">
                                                    <span class="ca-rate-text" t-esc="dept.completion_rate + '%'"></span>
                                                    <div class="ca-mini-track">
                                                        <div class="ca-mini-bar" t-attf-style="width: {{ Math.min(dept.completion_rate, 100) }}%;"></div>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                        <div class="ca-card-footer-link" t-on-click="openAllDepartments" style="display: none;">
                            View All Departments →
                        </div>
                    </div>

                    <!-- Top Assignees by Completion -->
                    <div class="ca-card ca-table-card">
                        <div class="ca-card-header">
                            <span class="ca-card-title">Top Assignees by Completion</span>
                        </div>
                        <div class="ca-table-scroll-container">
                            <table class="ca-clean-table">
                                <thead>
                                    <tr>
                                        <th>Assignee</th>
                                        <th>Completed</th>
                                        <th>Total Tasks</th>
                                        <th>Rate</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.data.top_assignees" t-as="user" t-key="user.id">
                                        <tr t-on-click="() => this.filterByAssignee(user.id)">
                                            <td>
                                                <div class="ca-row-name-cell">
                                                    <img class="ca-assignee-avatar" t-att-src="user.avatar_url" alt="Assignee Avatar" t-on-error="onAvatarError"/>
                                                    <span class="ca-row-name-text" t-esc="user.name"></span>
                                                </div>
                                            </td>
                                            <td class="ca-num-cell" t-esc="user.completed"></td>
                                            <td class="ca-num-cell" t-esc="user.total_tasks"></td>
                                            <td>
                                                <div class="ca-rate-progress-cell">
                                                    <span class="ca-rate-text" t-esc="user.rate + '%'"></span>
                                                    <div class="ca-mini-track">
                                                        <div class="ca-mini-bar" t-attf-style="width: {{ Math.min(user.rate, 100) }}%;"></div>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                        <div class="ca-card-footer-link" t-on-click="openAllAssignees" style="display: none;">
                            View All Assignees →
                        </div>
                    </div>

                    <!-- Top Projects by Progress -->
                    <div class="ca-card ca-table-card">
                        <div class="ca-card-header">
                            <span class="ca-card-title">Top Projects by Progress</span>
                        </div>
                        <div class="ca-table-scroll-container">
                            <table class="ca-clean-table">
                                <thead>
                                    <tr>
                                        <th>Project</th>
                                        <th>Progress</th>
                                        <th>Tasks</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.data.top_projects" t-as="proj" t-key="proj.id">
                                        <tr t-on-click="() => this.filterByProject(proj.id)">
                                            <td>
                                                <div class="ca-row-name-cell">
                                                    <div class="ca-project-box-icon" t-attf-style="background-color: {{ proj.bg_color }}; color: {{ proj.color }};">
                                                        <i t-attf-class="fa {{ proj.icon }}"></i>
                                                    </div>
                                                    <span class="ca-row-name-text" t-esc="proj.name"></span>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="ca-rate-progress-cell">
                                                    <span class="ca-rate-text" t-esc="proj.progress + '%'"></span>
                                                    <div class="ca-mini-track">
                                                        <div class="ca-mini-bar" t-attf-style="width: {{ Math.min(proj.progress, 100) }}%;"></div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="ca-num-cell" t-esc="proj.tasks"></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                        <div class="ca-card-footer-link" t-on-click="openAllProjects" style="display: none;">
                            View All Projects →
                        </div>
                    </div>
                </div>

                <!-- Fourth Row (Productivity Trend + Insights) -->
                <div class="ca-bottom-row">
                    <!-- Productivity Trend Combo Chart -->
                    <div class="ca-card ca-prod-trend-card">
                        <div class="ca-card-header">
                            <div class="ca-card-title-group">
                                <span class="ca-card-title">Productivity Trend</span>
                                <div class="ca-chart-legend-top">
                                    <div class="ca-legend-bullet-item">
                                        <span class="ca-bullet-rect" style="background-color: #C4B5FD;"></span>
                                        <span>Tasks Completed</span>
                                    </div>
                                    <div class="ca-legend-bullet-item">
                                        <span class="ca-bullet-dot" style="background-color: #10B981;"></span>
                                        <span>Completion Rate (%)</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="ca-chart-canvas-wrapper ca-prod-canvas-wrapper">
                            <canvas t-ref="productivityCanvas"></canvas>
                        </div>
                    </div>

                    <!-- Insights Card with Visual Graphic -->
                    <div class="ca-card ca-insights-card">
                        <div class="ca-card-header">
                            <span class="ca-card-title">Insights</span>
                        </div>
                        <div class="ca-insights-body">
                            <div class="ca-insights-list">
                                <t t-foreach="state.data.insights" t-as="ins" t-key="ins_index">
                                    <div class="ca-insight-item">
                                        <div class="ca-insight-icon" t-attf-style="background-color: {{ ins.bg_color }}; color: {{ ins.color }};">
                                            <i t-attf-class="fa {{ ins.icon }}"></i>
                                        </div>
                                        <div class="ca-insight-text" t-esc="ins.text"></div>
                                    </div>
                                </t>
                            </div>
                            <!-- Vector Dashboard Illustration -->
                            <div class="ca-insights-graphic">
                                <svg width="140" height="110" viewBox="0 0 140 110" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <!-- Background blob -->
                                    <path d="M15 35C15 15.67 30.67 0 50 0H110C126.569 0 140 13.4315 140 30V80C140 96.5685 126.569 110 110 110H45C22.9086 110 5 92.0914 5 70V45C5 39.4772 9.47715 35 15 35Z" fill="#F3F4F6" fill-opacity="0.6"/>
                                    <!-- Window Card -->
                                    <rect x="20" y="20" width="95" height="65" rx="6" fill="#FFFFFF" stroke="#E2E8F0" stroke-width="1.5"/>
                                    <!-- Header bar -->
                                    <line x1="20" y1="32" x2="115" y2="32" stroke="#F1F5F9" stroke-width="1.5"/>
                                    <circle cx="28" cy="26" r="2" fill="#8B5CF6"/>
                                    <circle cx="34" cy="26" r="2" fill="#3B82F6"/>
                                    <circle cx="40" cy="26" r="2" fill="#10B981"/>
                                    
                                    <!-- Mini Pie Chart -->
                                    <circle cx="45" cy="50" r="14" fill="#F8FAFC"/>
                                    <path d="M 45 50 L 45 36 A 14 14 0 0 1 59 50 Z" fill="#8B5CF6"/>
                                    <path d="M 45 50 L 59 50 A 14 14 0 0 1 45 64 Z" fill="#3B82F6"/>
                                    <path d="M 45 50 L 45 64 A 14 14 0 0 1 31 50 Z" fill="#10B981"/>
                                    <path d="M 45 50 L 31 50 A 14 14 0 0 1 45 36 Z" fill="#F59E0B"/>

                                    <!-- Mini Bars -->
                                    <rect x="70" y="44" width="6" height="22" rx="2" fill="#C4B5FD"/>
                                    <rect x="80" y="38" width="6" height="28" rx="2" fill="#8B5CF6"/>
                                    <rect x="90" y="48" width="6" height="18" rx="2" fill="#C4B5FD"/>
                                    <rect x="100" y="40" width="6" height="26" rx="2" fill="#8B5CF6"/>

                                    <!-- Lines underneath -->
                                    <rect x="25" y="74" width="30" height="3" rx="1.5" fill="#E2E8F0"/>
                                    <rect x="62" y="74" width="45" height="3" rx="1.5" fill="#E2E8F0"/>

                                    <!-- Magnifying Glass -->
                                    <circle cx="100" cy="78" r="16" fill="#FFFFFF" stroke="#4F46E5" stroke-width="4"/>
                                    <circle cx="100" cy="78" r="10" fill="#EEF2FF" fill-opacity="0.8"/>
                                    <line x1="112" y1="89" x2="128" y2="105" stroke="#4F46E5" stroke-width="5" stroke-linecap="round"/>
                                    <line x1="114" y1="91" x2="126" y2="103" stroke="#818CF8" stroke-width="2" stroke-linecap="round"/>
                                </svg>
                            </div>
                        </div>
                        <div class="ca-card-footer-link" t-on-click="openAllProjects">
                            View All Projects →
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
